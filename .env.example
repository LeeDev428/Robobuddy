# ============================================
# RoboBuddy Environment Variables Template
# ============================================
# Copy this to .env and fill in your values
# Used by: ai_robot/config.py

# ------  Groq API (Cloud LLM) ------
GROQ_API_KEY=your_groq_api_key_here

# ------ System Prompt (Robot Personality) ------
SYSTEM_PROMPT=You are RoboBuddy, a cute little robot assistant. Always respond in clear English. Keep replies short, calm, and accurate. Track recent context and answer follow-up questions directly when possible. If audio is unclear, ask one short clarification question instead of guessing.

# ------ Whisper STT (Local speech recognition) ------
# Options: tiny.en, base.en, small.en, medium.en (English-focused)
WHISPER_MODEL=base.en
LISTEN_TIMEOUT_SEC=8
PHRASE_TIME_LIMIT_SEC=12
REQUIRE_WAKE_WORD=false
WAKE_WORD=robobuddy

# ------ YOLO Vision (Person Detection) ------
# Options: yolov8n.pt (nano, fast), yolov8s.pt (small), yolov8m.pt (medium)
YOLO_MODEL=yolov8n.pt
CAMERA_INDEX=0
PERSON_CONFIDENCE=0.45

# ------ Raspberry Pi Socket Connection ------
ROBOT_HOST=192.168.1.50
ROBOT_PORT=5000
SOCKET_TIMEOUT_SEC=2.0

# ------ Text-to-Speech (edge-tts neural voice) ------
TTS_VOICE=en-US-AriaNeural
TTS_RATE_PCT=+22%
TTS_PITCH_HZ=+45Hz
TTS_VOLUME=1.0

# ------ Data Storage (Laptop-side logging) ------
ROBOBUDDY_DATA_DIR=./robobuddy_data

# ------  Optional: Advanced Settings ------
# YOLO_DEVICE=cpu              # Use 'cpu' or 'cuda' for GPU (auto-detected)
# STORAGE_RETENTION_DAYS=90    # Auto-delete logs older than N days (future feature)
